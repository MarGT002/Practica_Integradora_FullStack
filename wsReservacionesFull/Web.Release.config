<?xml version="1.0" encoding="utf-8"?>
<!--
  Transformación que Visual Studio aplica AUTOMÁTICAMENTE al hacer Publish (configuración Release).
  Así el sitio publicado en EC2 apunta a la API publicada en el mismo servidor IIS,
  sin tener que editar el Web.config a mano.
  Reemplaza el contenido del Web.Release.config del proyecto por este.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <!-- El servidor llama a la API dentro del mismo EC2 -->
    <add key="urlApi" value="http://localhost/apiReservaciones"
         xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <!-- El navegador usa una ruta relativa: funciona con la IP elástica o con un dominio -->
    <add key="urlApiPublica" value="/apiReservaciones"
         xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
  </system.web>
</configuration>
